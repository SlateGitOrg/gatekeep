# gatekeep reads secrets only from the environment (names configurable in
# gatekeep.yaml). Generate values with `gatekeep secret`.

# OIDC client secret registered at the identity provider.
GATEKEEP_CLIENT_SECRET=

# Comma-separated base64 secrets (>= 32 bytes each). The first seals new
# cookies; the rest are still accepted for decryption during key rotation.
GATEKEEP_SESSION_SECRETS=
